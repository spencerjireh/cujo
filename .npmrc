# Flat node_modules so workspace packages share hoisted tool binaries
# (biome, tsc, vitest, tsup) without re-declaring them per package.
node-linker=hoisted

# The deploy box's link to the registry drops connections under load; the
# defaults (2 retries, 16 parallel fetches) gave up mid-install twice on
# 2026-10-19 (decision 176).
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
network-concurrency=8
