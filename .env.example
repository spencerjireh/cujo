# Copy to .env for local runs, or set these in Coolify's environment for deploy.
# Never commit real secrets.

# Postgres credentials (used by the postgres service and the harness).
POSTGRES_USER=cujo
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=cujo

# Public origin Traefik serves. Baked into MCP OAuth callbacks and the webhook.
PUBLIC_BASE_URL=https://cujo.spencerjireh.com

# NOTE: the Gemini model key and the Daytona sandbox key are NOT set here.
# They are entered in the TrueForge UI (Settings > Models, Settings > Sandbox
# providers) after first boot and stored in Postgres.
