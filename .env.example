# Copy to .env for local runs, or set these in Coolify's environment for deploy.
# Never commit real secrets.

# Postgres credentials (used by the postgres service and the harness).
POSTGRES_USER=cujo
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=cujo

# Public origin of the TrueForge operator console. Baked into MCP OAuth
# callbacks. For local runs with `make up-local`, docker-compose.local.yml
# overrides this with http://localhost:8790.
PUBLIC_BASE_URL=https://cujo-harness.spencerjireh.com

# Hostnames the cujo service dispatches on (spec Contract 6). The local overlay
# sets these to cujo.localhost and cujo-ingress.localhost.
CUJO_UI_HOST=cujo.spencerjireh.com
CUJO_WEBHOOK_HOST=cujo-ingress.spencerjireh.com

# Cloudflare Access: the team domain and the audience tag of the Access
# application in front of CUJO_UI_HOST. Every UI/API request must carry a valid
# Cf-Access-Jwt-Assertion. The local overlay disables this check.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# The Cujo GitHub App. The private key is the PEM text; literal \n is accepted.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Model the agent runs on, as a TrueForge FQN: <provider name>/<model name>.
CUJO_MODEL=

# Optional: register the model provider and the Daytona sandbox provider on the
# harness at start. Leave unset to add them in the operator console instead.
# MODEL_PROVIDER_MODELS is a comma list of <model name>=<provider model id>.
MODEL_PROVIDER_NAME=
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODELS=
DAYTONA_API_KEY=

# Where the agent fetches sniff.py from inside the sandbox (public, tokenless).
CUJO_SNIFF_URL=https://raw.githubusercontent.com/spencerjireh/cujo/main/sniff.py
