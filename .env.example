# Copy to .env for local runs, or set these in Coolify's environment for deploy.
# Never commit real secrets.
#
# Required (the services exit at start without them): POSTGRES_*, GITHUB_APP_ID,
# GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, CUJO_MODEL, and CF_ACCESS_*
# unless CUJO_DEV_NO_ACCESS=1 (the local overlay sets it).

# Postgres credentials (used by the postgres service and the harness).
POSTGRES_USER=cujo
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=cujo

# Public origin of the TrueForge operator console. Baked into MCP OAuth
# callbacks. For local runs with `make up-local`, docker-compose.local.yml
# overrides this with http://localhost:8790.
PUBLIC_BASE_URL=https://cujo-harness.spencerjireh.com

# Hostnames the cujo service dispatches on (spec Contract 6). The local overlay
# sets these to cujo.localhost and cujo-ingress.localhost.
#
# CUJO_UI_HOST is the Access-gated operator hostname. Since decision 34 that is
# cujo-admin: the reverse proxy routes it to the `web` service, which proxies
# /api/* back to cujo over the compose network. CUJO_INTERNAL_HOST is the name
# `web` addresses cujo by on that network, and cujo serves the same Access-gated
# API routes on it. Both are set in the compose file, so neither normally needs
# a value here.
CUJO_UI_HOST=cujo-admin.spencerjireh.com
CUJO_INTERNAL_HOST=cujo
CUJO_WEBHOOK_HOST=cujo-ingress.spencerjireh.com

# The anonymous board, read by the `web` service (decision 34). It is public
# ONLY on an exact match of this name: any other Host, and an unset value, are
# treated as the operator plane, which then needs an Access assertion and is
# refused without one. That direction is deliberate — defaulting the other way
# would serve the public view to any hostname nobody had configured.
CUJO_PUBLIC_HOST=cujo.spencerjireh.com
# Where the public board links when a run is waiting on a human decision.
CUJO_ADMIN_BASE_URL=https://cujo-admin.spencerjireh.com

# Cloudflare Access: the team domain and the audience tag of the Access
# application in front of CUJO_UI_HOST. Every UI/API request must carry a valid
# Cf-Access-Jwt-Assertion. The local overlay disables this check.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# The Cujo GitHub App (required). The private key is the PEM text; literal \n
# is accepted.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Model the agent runs on (required), as a TrueForge FQN:
# <provider name>/<model name>.
CUJO_MODEL=

# Optional: Discord notifications (spec Contract 7). The bot token of a Discord
# application whose bot is in the server and can see the channel. Leave unset
# and Cujo simply does not notify. The repo-to-channel map is operator data and
# lives in the run store behind the API, not here (decision 23).
DISCORD_BOT_TOKEN=

# Optional: the `/cujo` slash command (spec Contract 8). The Discord
# application's public key, from its General Information page — not the bot
# token. Without it notifications still work and the interactions route is not
# served at all. Set the application's Interactions Endpoint URL to
# https://$CUJO_WEBHOOK_HOST/discord/interactions.
DISCORD_PUBLIC_KEY=

# Run links in a Discord card. CUJO_UI_BASE_URL is the operator UI and defaults
# to https://$CUJO_UI_HOST, so it follows CUJO_UI_HOST to cujo-admin. A card for
# a PUBLIC run links to CUJO_PUBLIC_BASE_URL instead, because a repo's channel
# holds its team rather than Cujo's operators and most of them cannot pass
# Access; that page carries its own link on to the operator UI when a decision
# is pending. Empty falls back to CUJO_UI_BASE_URL.
#
# CUJO_PUBLIC_BASE_URL is read by BOTH cujo and github-mcp. github-mcp uses it
# to build the "Full evidence" footer on a public repo's review, which is why
# the host lives in the environment and not in a value the agent supplies:
# nothing the agent read in a pull request can then choose where that link
# points. Unset means no review carries a footer.
#CUJO_UI_BASE_URL=
CUJO_PUBLIC_BASE_URL=https://cujo.spencerjireh.com

# Optional tuning. CUJO_TURN_TIMEOUT_MS bounds one turn including stream
# retries (default 30 minutes); the Daytona idle-stop interval is derived from
# it. CUJO_DEV_NO_ACCESS=1 turns the Access check off; only for local runs.
#CUJO_TURN_TIMEOUT_MS=1800000
#CUJO_DEV_NO_ACCESS=1

# The public plane (decision 34). CUJO_PUBLIC_STREAM_LIMIT caps concurrent
# anonymous run streams this process holds (default 200); past it the board
# falls back to polling and says so, and operator streams are never counted.
# CUJO_VISIBILITY_RECHECK_MS is how often every repo with a run is re-asked
# whether it is still public (default 15 minutes); 0 turns the sweep off, and
# the `repository` webhook still carries a flip within seconds. Anything that
# is not a whole number falls back to the default rather than to zero.
#CUJO_PUBLIC_STREAM_LIMIT=200
#CUJO_VISIBILITY_RECHECK_MS=900000

# Cujo reacts on the pull request it is reviewing and moves that reaction with
# the run's status (decision 38): an eye when the run is claimed, then a verdict.
# Set to 0 to turn it off; anything else, including unset, leaves it on.
#CUJO_PR_REACTIONS=1

# Optional: register the model provider and the Daytona sandbox provider on the
# harness at start. Leave unset to add them in the operator console instead.
# MODEL_PROVIDER_MODELS is a comma list of <model name>=<provider model id>.
MODEL_PROVIDER_NAME=
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODELS=
DAYTONA_API_KEY=

# Where the agent fetches sniff.py from inside the sandbox (public, tokenless).
CUJO_SNIFF_URL=https://raw.githubusercontent.com/spencerjireh/cujo/main/sandbox/sniff.py
