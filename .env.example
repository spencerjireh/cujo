# Copy to .env for local runs, or set these in Coolify's environment for deploy.
# Never commit real secrets.
#
# Required (the services exit at start without them): GITHUB_APP_ID,
# GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, CUJO_MODEL, and the
# MODEL_PROVIDER_* block below.

# Hostnames the cujo service dispatches on (spec Contract 6). The local overlay
# sets CUJO_WEBHOOK_HOST to cujo-ingress.localhost.
#
# CUJO_INTERNAL_HOST is the name `web` addresses cujo by on the compose
# network, and since decision 57 it is the only name the read plane answers on:
# Node's fetch always sends the target's own authority as Host, so the proxy
# could never present a published hostname anyway. Both are set in the compose
# file, so neither normally needs a value here.
CUJO_INTERNAL_HOST=cujo
CUJO_WEBHOOK_HOST=cujo-ingress.spencerjireh.com

# The Cujo GitHub App (required). The private key is the PEM text; literal \n
# is accepted.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Model the agent runs on (required), as <provider name>/<model name>: the
# provider registered below and one of the names in MODEL_PROVIDER_MODELS.
CUJO_MODEL=

# Optional: how hard that model is asked to think — none, minimal, low, medium,
# high, xhigh, max. The harness clamps it against what the model declares
# (decision 127): a model with MODEL_PROVIDER_REASONING=0 gets none, and xhigh
# or max fold to high unless the model maps them. Leave unset for the
# provider's default (decision 53).
CUJO_MODEL_REASONING_EFFORT=

# Optional: Discord notifications (spec Contract 7). The bot token of a Discord
# application whose bot is in the server and can see the channel. Leave unset
# and Cujo simply does not notify. The repo-to-channel map is operator data and
# lives in the run store behind the API, not here (decision 23).
DISCORD_BOT_TOKEN=

# Optional: the `/cujo` slash command (spec Contract 8). The Discord
# application's public key, from its General Information page — not the bot
# token. Without it notifications still work and the interactions route is not
# served at all. Set the application's Interactions Endpoint URL to
# https://$CUJO_WEBHOOK_HOST/discord/interactions.
DISCORD_PUBLIC_KEY=

# Optional: the one Discord server this deploy serves (decision 40). A repo
# that names no `discord_guild` in its `.cujo.yml` belongs to this server, so a
# single-server deploy needs no per-repo commit. It is one id and never a list:
# a server that invited the bot on its own is refused exactly as before, and a
# repo that names a different server still wins. Unset means every repo must
# declare, which is Contract 8's original rule.
CUJO_DEFAULT_DISCORD_GUILD=

# Run links in a Discord card, and the only origin there is. A card for a
# PUBLIC run links here; a private run has no page at all since decision 57, so
# its card carries no link. Unset means no card carries one.
#
# CUJO_PUBLIC_BASE_URL is read by BOTH cujo and github-mcp. github-mcp uses it
# to build the evidence-link footer on a public repo's review, which is why
# the host lives in the environment and not in a value the agent supplies:
# nothing the agent read in a pull request can then choose where that link
# points. Unset means no review carries a footer.
CUJO_PUBLIC_BASE_URL=https://cujo.spencerjireh.com

# Optional: the login name of the GitHub App bot user, used to identify own
# reviews when dismissing stale ones. Default matches the production app.
#CUJO_BOT_LOGIN=cujo-guard[bot]

# Optional: public origin of the Cujo board, used by apps/web for metadataBase
# (Open Graph URLs). The compose file defaults this for deploy; set it here
# only when running outside compose.
#CUJO_WEB_ORIGIN=https://cujo.spencerjireh.com

# Optional tuning. CUJO_TURN_TIMEOUT_MS bounds one turn including stream
# retries (default 30 minutes). The harness has no timeout of its own; this
# watchdog is what ends a review that hangs.
#CUJO_TURN_TIMEOUT_MS=1800000
# Sampling. Both unset by default, and unset means the key is not sent at all:
# every key in model.params reaches the provider verbatim, and some reasoning
# models reject `temperature` or accept only 1. Setting one your provider
# refuses fails invisibly — the process reports healthy and answers 502 to
# every pull request. Check first, then set.
#CUJO_MODEL_TEMPERATURE=0
#CUJO_MODEL_MAX_TOKENS=16000

# The diff review (Contract 11, decision 135). CUJO_REVIEW_MODE is the review a
# repository gets when its .cujo.yml names none: `sandbox` (default) runs the
# pull request, `diff` reads it against the repository's standards files and
# never provisions a box. A dependency-manifest change or a Bot-authored pull
# request is always the sandbox. The diff review has its own model (must be in
# MODEL_PROVIDER_MODELS; unset means CUJO_MODEL), its own budget in billed
# tokens per run (decision 132), its own ceiling, and a cap on the bytes of
# diff it is handed.
#CUJO_REVIEW_MODE=sandbox
#CUJO_DIFF_MODEL=openrouter/glm-flash
#CUJO_DIFF_BUDGET_TOKENS=400000
#CUJO_DIFF_TIMEOUT_MS=600000
#CUJO_DIFF_BYTES=60000

# The public plane (decision 34). CUJO_PUBLIC_STREAM_LIMIT caps concurrent
# anonymous run streams this process holds (default 200); past it the board
# falls back to polling and says so, and operator streams are never counted.
# CUJO_VISIBILITY_RECHECK_MS is how often every repo with a run is re-asked
# whether it is still public (default 15 minutes); 0 turns the sweep off, and
# the `repository` webhook still carries a flip within seconds. Anything that
# is not a whole number falls back to the default rather than to zero.
#CUJO_PUBLIC_STREAM_LIMIT=200
#CUJO_VISIBILITY_RECHECK_MS=900000

# `@cujo-guard <question>` on a pull request (decision 47). This is the one
# path where a comment provisions a sandbox, so it has a ceiling: at most
# CUJO_CONVERSE_LIMIT questions per pull request per CUJO_CONVERSE_WINDOW_MS
# (defaults: 3 an hour), one at a time, and repo write is required either way.
# CUJO_CONVERSE_LIMIT=0 turns conversation off entirely and deliveries are
# still answered 200. CUJO_CONVERSE_TIMEOUT_MS bounds one answer (default 10
# minutes), after which the person is told it did not finish.
#CUJO_CONVERSE_LIMIT=3
#CUJO_CONVERSE_WINDOW_MS=3600000
#CUJO_CONVERSE_TIMEOUT_MS=600000

# Cujo reacts on the pull request it is reviewing and moves that reaction with
# the run's status (decision 38): an eye when the run is claimed, then a verdict.
# Set to 0 to turn it off; anything else, including unset, leaves it on.
#CUJO_PR_REACTIONS=1
# Cujo writes a `cujo/guard` check run on each commit it reviews and moves it
# with the run's status (decision 138): in progress, then success, failure on a
# block, neutral once a maintainer dismisses. Require it in branch protection
# and the block holds the merge. Needs `checks: write` on the App. Set to 0 to
# turn it off; anything else, including unset, leaves it on.
#CUJO_PR_CHECKS=1

# How long a push waits before its run starts, in milliseconds, so a burst of
# pushes is one run on the last head rather than one run per push, each
# cancelled by the next (decision 144). 0 starts every push at once.
#CUJO_PUSH_DEBOUNCE_MS=60000

# The model provider, registered on the harness at start (decision 127). An
# OpenAI-compatible chat-completions endpoint; MODEL_PROVIDER_MODELS is a comma
# list of <model name>=<provider model id>, and CUJO_MODEL above names one of
# them as <provider name>/<model name>. The three limits apply to every model
# in the list: the window the harness compacts against, the output cap, and
# whether a reasoning effort means anything to the model (0 turns it off).
MODEL_PROVIDER_NAME=openrouter
MODEL_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODELS=
#MODEL_PROVIDER_CONTEXT_WINDOW=128000
#MODEL_PROVIDER_MAX_TOKENS=16384
#MODEL_PROVIDER_REASONING=1

# Where cujo finds the harness. The compose file sets this; set it here only
# when running outside compose.
#HARNESS_BASE_URL=http://harness:8790

# The sandbox, behind an interface and reached over MCP (decision 113). `local`
# is a container on this host with egress enforced by a gateway outside it;
# `daytona` is the old vendor, kept so the move is reversible on one variable.
# Anything else refuses to boot rather than defaulting.
CUJO_SANDBOX_RUNTIME=local
# The two images the local runtime runs. Tags, not pulls: sandbox-mcp builds
# both at boot from sandbox/Dockerfile and apps/sandbox-mcp/gateway/Dockerfile,
# which its own image carries (decision 118), and answers 503 until they exist.
# The sandbox image is this deployment's, never a caller's.
CUJO_SANDBOX_IMAGE=cujo-sandbox:latest
CUJO_SANDBOX_GATEWAY_IMAGE=cujo-sandbox-gateway:latest
# Where those build contexts sit inside the sandbox-mcp container. Set it empty
# to skip the boot-time build and run whatever the two tags already name, which
# is what a developer with both built by hand wants.
CUJO_SANDBOX_IMAGES_DIR=/app/images
# gVisor. Empty falls back to Docker's default runtime, with a warning on every
# create: a host that has not been provisioned yet still runs reviews.
CUJO_SANDBOX_CONTAINER_RUNTIME=runsc
# The network the egress gateway reaches the internet through.
CUJO_SANDBOX_EGRESS_NETWORK=bridge

# Optional: Open Code Review beside every run (decision 149). Set the URL and
# cujo asks the ocr-sidecar service on every run and stores its answer; unset,
# no run asks. The sidecar's own model settings follow: URL, token and model
# are what `ocr` requires, and the protocol is `openai` for an
# OpenAI-compatible endpoint such as OpenRouter or `anthropic` for one that
# speaks Anthropic's. Point them at the same model as CUJO_DIFF_MODEL so the
# comparison isolates the tool.
#CUJO_OCR_SIDECAR_URL=http://ocr-sidecar:8083
#CUJO_OCR_TIMEOUT_MS=1260000
OCR_LLM_URL=
OCR_LLM_TOKEN=
OCR_LLM_MODEL=
OCR_LLM_PROTOCOL=openai
#OCR_LLM_TIMEOUT=120
#OCR_MAX_TOKENS_BUDGET=400000
#OCR_SIDECAR_TIMEOUT_MS=1200000
