.env
*.pem
.playwright-mcp/
# Agent working state, including the git worktrees it creates. Untracked, and
# ignored so Biome skips it: with noConsole on (decision 37) an unignored
# worktree makes `pnpm lint` red for whoever has one, on code that is a copy
# of another branch rather than of this one.
.claude/
# Local working screenshots from setup, not part of the project
*.png
!brand/**/*.png
# The board's favicon PNG fallback, tracked like the SVG beside it
!apps/web/src/app/icon.png

# Node / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo

# Next.js / Storybook build output
.next/
storybook-static/
next-env.d.ts

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# brand render output
brand/logo/png/
